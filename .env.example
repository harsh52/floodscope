# Copy to .env and fill in. Never commit .env.

# REQUIRED — the agent brain / code generation (Claude via Anthropic API)
ANTHROPIC_API_KEY=sk-ant-...

# Model ids (defaults are sensible; override if you like)
FLOODSCOPE_AGENT_MODEL=claude-opus-4-8
FLOODSCOPE_BAnow SELINE_MODEL=claude-opus-4-8

# OPTIONAL — only needed for Sentinel-1 RTC (terrain-corrected) data.
# The default pipeline uses sentinel-1-grd which is ANONYMOUS (no key required),
# so judges can reproduce without any signup. Leave blank to stay on GRD.
PC_SDK_SUBSCRIPTION_KEY=
